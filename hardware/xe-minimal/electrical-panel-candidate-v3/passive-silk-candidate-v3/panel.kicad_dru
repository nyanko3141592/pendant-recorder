(version 1)
(rule "P1_U8 SMD pad pairs - JLC 1oz multilayer"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('P1_U8') && B.memberOfFootprint('P1_U8')")
  (constraint clearance (min 0.09mm)))

